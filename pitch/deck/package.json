{
  "name": "field-shift-pitch-deck",
  "private": true,
  "version": "0.1.0",
  "description": "The pitch deck: a static page driven by the arrow keys. Separate from the app, so the app's dependencies do not change.",
  "scripts": {
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "data": "sh scripts/export-data.sh",
    "pdf": "node scripts/export-pdf.mjs",
    "record": "node scripts/record.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
