{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/pitch",
      "destination": "https://github.com/startupowe1konto1/NASA-Space-Apps-Hackathon/blob/main/pitch/out/deck.pdf",
      "permanent": false
    },
    {
      "source": "/pitch/",
      "destination": "https://github.com/startupowe1konto1/NASA-Space-Apps-Hackathon/blob/main/pitch/out/deck.pdf",
      "permanent": false
    },
    {
      "source": "/pitch/:path*",
      "destination": "https://github.com/startupowe1konto1/NASA-Space-Apps-Hackathon/blob/main/pitch/out/deck.pdf",
      "permanent": false
    }
  ]
}
